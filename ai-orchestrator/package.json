    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.315",
    "@types/node": "24.19.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
