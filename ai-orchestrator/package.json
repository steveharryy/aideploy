{
  "name": "ai-orchestrator",
  "version": "1.0.0",
  "description": "Local AI Development Orchestrator POC",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "qa": "tsx src/qa-runner.ts",
    "clean": "tsx src/clean-repos.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
