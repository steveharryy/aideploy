# AI Orchestrator Environment Variables
# Copy to .env (never commit .env).

# ── AI provider ────────────────────────────────────────────────
# Only "mock" (offline, deterministic) is available.
AI_PROVIDER=mock

# ── Jira Cloud (needed for `npm start -- RT-123` / --jql) ──────
# Site URL, e.g. https://your-site.atlassian.net
JIRA_BASE_URL=https://your-site.atlassian.net
# Atlassian account email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token-here
# Optional: custom field id holding acceptance criteria (otherwise parsed
# from an "Acceptance Criteria" section in the description)
# JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_10042

# ── Paths ──────────────────────────────────────────────────────
# Path to repositories (default: ./repositories)
REPOSITORIES_ROOT=./repositories

# ── Pipeline state & workspaces (optional; defaults shown) ─────
# Service catalog: repos, routing, deploy order, verify commands
# CATALOG_PATH=./catalog/repos.yaml
# Per-ticket job state + lock: .jobs/<TICKET>/job.json
# JOBS_DIR=.jobs
# Per-ticket git worktrees (branch ai/<ticket>) for standalone git repos
# WORKTREES_DIR=.worktrees

# ── Automation watcher (npm run watch) ─────────────────────────
# Which tickets it looks at (default: project T2, labels ai-ready / ai-approved, not Done)
# AUTOMATION_PROJECT=T2
# AUTOMATION_JQL=project = T2 AND labels in ("ai-ready","ai-approved") AND statusCategory != Done
# Skip the human plan approval (NOT recommended)
# AUTO_APPROVE_PLAN=false
# Max implementation attempts per ticket before handing to a human
# AUTOMATION_MAX_ATTEMPTS=3
# Optional: move tickets through your workflow (only if these status names exist)
# JIRA_STATUS_IN_PROGRESS=In Progress
# JIRA_STATUS_IN_REVIEW=In Review
# Label names (defaults shown)
# LABEL_READY=ai-ready
# LABEL_PLAN_PENDING=ai-plan-pending
# LABEL_APPROVED=ai-approved
# LABEL_IN_PROGRESS=ai-in-progress
# LABEL_PR_RAISED=ai-pr-raised
# LABEL_DONE=ai-done
# LABEL_NEEDS_HUMAN=ai-needs-human

# ── Bitbucket pull requests ────────────────────────────────────
# Preferred: repository access token (scopes: repository:write, pullrequest:write)
# BITBUCKET_TOKEN=
# Or: Atlassian email + scoped API token
# BITBUCKET_EMAIL=
# BITBUCKET_API_TOKEN=
