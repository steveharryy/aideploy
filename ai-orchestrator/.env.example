# AI Orchestrator Environment Variables

# Choose AI Provider: "mock" (default, local/offline) or "claude"
AI_PROVIDER=mock

# Anthropic Claude API Configuration (Required when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Claude Model (Defaults to claude-3-5-sonnet-20241022)
# Supported options:
# - claude-3-5-sonnet-20241022 (Recommended for coding)
# - claude-3-7-sonnet-20250219
# - claude-3-5-haiku-20241022  (Faster, cheaper)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Path to repositories (default: ./repositories)
REPOSITORIES_ROOT=./repositories
