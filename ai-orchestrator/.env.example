# AI Orchestrator environment variables
# Copy to .env (never commit .env). Limits, intake rules and switches live in
# config/pipeline.yaml instead, so they can change without touching secrets.

# ── AI provider (coding phase) ─────────────────────────────────
# The coding phase only runs when coding.enabled is true in config/pipeline.yaml.
#   coding-agent  full coding agent: tests first → implement → checks → scope → reviewer (Claude Code)  [default]
#   claude-code   single Claude Code pass in a sandbox
#   claude        Anthropic API (needs ANTHROPIC_API_KEY with credits)
#   handoff       change set prepared in .handoff/<ticket>/<repo>.json
#   mock          offline demo only
# Planning always uses the Planning Agent (Claude Code) with coding-agent or claude-code.
AI_PROVIDER=coding-agent
# Coding agent: fix rounds shared by checks, scope and review findings
# CODING_MAX_ITERATIONS=3
# Model for the CODING agent only (tests + code). The reviewer and planner use CLAUDE_CODE_MODEL / the CLI default.
# CODING_AGENT_MODEL=sonnet

# ── Jira Cloud (required) ──────────────────────────────────────
# Use a dedicated bot account, not a personal token: every comment the pipeline posts
# is shown under this account.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=ai-bot@example.com
JIRA_API_TOKEN=your-jira-api-token-here
# Optional: custom field holding acceptance criteria (otherwise read from an
# "Acceptance Criteria" section in the description)
# JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_10042
# Product / story points fields are set in config/pipeline.yaml (jira.product_field,
# jira.story_points_field); these variables override them:
# JIRA_PRODUCT_FIELD=customfield_10224
# JIRA_STORY_POINTS_FIELD=customfield_10070

# ── Trigger labels (the only labels the pipeline uses) ─────────
# A person adds LABEL_READY to start planning (or to resume after answering questions)
# and LABEL_APPROVED to approve a plan. The pipeline removes a label once it has acted
# on it; everything else is a Jira comment. Each ticket's phase is kept in
# .jobs/<ticket>/session.json.
# LABEL_READY=ai-ready
# LABEL_APPROVED=ai-approved

# ── Watcher (npm run watch) ────────────────────────────────────
# AUTOMATION_PROJECT=T2
# Whose tickets the watcher acts on: default only tickets reported by the JIRA_EMAIL account,
# so two people testing on the same project never pick up each other's tickets.
# AUTOMATION_REPORTER=any         # everyone's tickets (production)
# AUTOMATION_REPORTER=<accountId> # one specific reporter
# Default JQL: project = <AUTOMATION_PROJECT> [AND reporter = ...] AND labels in (<ready>, <approved>) AND statusCategory != Done
# AUTOMATION_JQL=
# Coding attempts per ticket before a person takes over
# AUTOMATION_MAX_ATTEMPTS=3
# Overrides planning.max_question_rounds in config/pipeline.yaml
# AUTOMATION_MAX_QUESTION_ROUNDS=2
# Skip the human plan approval. Leave false.
# AUTO_APPROVE_PLAN=false

# ── Webhook (npm run webhook) ──────────────────────────────────
# Shared secret, at least 16 characters. Generate: openssl rand -hex 32
# Jira system webhook: put it in the webhook's "Secret" field (sent as an X-Hub-Signature HMAC).
# Jira Automation "Send web request": send it as header X-Webhook-Secret.
# JIRA_WEBHOOK_SECRET=
# WEBHOOK_PORT=8080
# WEBHOOK_HOST=0.0.0.0
# Only events for these projects are accepted (default: AUTOMATION_PROJECT, else T2)
# WEBHOOK_PROJECTS=T2
# Safety-net JQL poll for missed webhooks, in minutes (0 = off)
# WEBHOOK_RECONCILE_MINUTES=15

# ── Emergency stop ─────────────────────────────────────────────
# true = start nothing new (same as kill_switch: true in config/pipeline.yaml)
# AI_KILL_SWITCH=false

# ── Claude Code ────────────────────────────────────────────────
# Binary (default: the project's node_modules/.bin/claude, then `claude` on PATH)
# CLAUDE_CODE_BIN=
# Model for coding / planning (default: the CLI's default; planning also reads planning.model in config)
# CLAUDE_CODE_MODEL=
# PLANNING_MODEL=
# Time limits in ms (planning normally uses planning.max_wall_clock_min from config)
# CLAUDE_CODE_TIMEOUT_MS=1800000
# PLANNING_TIMEOUT_MS=
# Keep the coding sandbox copy after a run, for debugging
# KEEP_SANDBOX=0
# Use ANTHROPIC_API_KEY instead of the logged-in Claude account (needs a real API key)
# CLAUDE_CODE_USE_API_KEY=false

# ── Anthropic API (only for AI_PROVIDER=claude) ────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ── Bitbucket pull requests (coding phase) ─────────────────────
# Repository access token (scopes: repository:write, pullrequest:write), or email + API token
# BITBUCKET_TOKEN=
# BITBUCKET_EMAIL=
# BITBUCKET_API_TOKEN=

# ── Paths (defaults shown) ─────────────────────────────────────
# Repo paths in catalog/repos.yaml are relative to this folder
# REPOSITORIES_ROOT=./repositories
# CATALOG_PATH=./catalog/repos.yaml
# PIPELINE_CONFIG_PATH=./config/pipeline.yaml
# COMPONENT_MAP_PATH=./config/components.yaml
# JOBS_DIR=.jobs
# WORKTREES_DIR=.worktrees
